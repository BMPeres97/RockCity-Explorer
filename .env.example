# ==========================================
# RockCity Explorer - Environment Variables Example
# SRS Section 38: Environment Variables
# Local Tourist Day-Visit Planner (Kurunegala, Sri Lanka)
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas connection string or local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/rockcity_explorer?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Administrator Credentials (SRS Section 38)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
DEFAULT_ADMIN_EMAIL=admin@rockcity.lk
DEFAULT_ADMIN_PASSWORD=AdminRockCity@2026

# CRITICAL FIXED REFERENCE LOCATION (Kurunegala Reference Point)
# All distance and travel-time figures are calculated deterministically from this point
REFERENCE_LATITUDE=7.4692807
REFERENCE_LONGITUDE=80.4424776
REFERENCE_LOCATION_NAME=Kurunegala Central Reference Point

# Travel Time Estimation (Average tourist vehicle speed in km/h)
AVERAGE_TRAVEL_SPEED_KMH=30
DEFAULT_AVERAGE_SPEED_KMH=30
