{
  "name": "rockcity-explorer",
  "version": "2.1.0",
  "description": "RockCity Explorer - Local Tourist Day-Visit Planner & Information System for Kurunegala, Sri Lanka",
  "private": true,
  "scripts": {
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "seed": "cd server && npm run seed",
    "dev": "concurrently --kill-others-on-fail -n \"SERVER,CLIENT\" -c \"bgBlue.bold,bgGreen.bold\" \"npm run server\" \"npm run client\"",
    "build": "cd client && npm run build",
    "test": "cd server && npm test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "kurunegala",
    "tourism",
    "day-planner",
    "rockcity",
    "mern",
    "leaflet"
  ],
  "author": "RockCity Explorer Team",
  "license": "MIT"
}
